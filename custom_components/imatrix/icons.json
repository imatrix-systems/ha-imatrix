{
  "entity": {
    "sensor": {
      "fuel_level": {
        "default": "mdi:gas-station"
      },
      "def_level": {
        "default": "mdi:water-outline"
      },
      "engine_hours": {
        "default": "mdi:engine-outline"
      },
      "engine_rpm": {
        "default": "mdi:engine"
      },
      "odometer": {
        "default": "mdi:counter"
      },
      "heading": {
        "default": "mdi:compass-outline"
      },
      "satellites": {
        "default": "mdi:satellite-variant"
      },
      "hdop": {
        "default": "mdi:crosshairs-gps"
      },
      "idle_time": {
        "default": "mdi:timer-sand"
      },
      "connectivity": {
        "default": "mdi:cloud-check-outline",
        "state": {
          "asleep": "mdi:sleep",
          "late": "mdi:cloud-clock-outline",
          "offline": "mdi:cloud-off-outline",
          "never": "mdi:cloud-question-outline"
        }
      },
      "last_seen": {
        "default": "mdi:clock-check-outline"
      }
    },
    "binary_sensor": {
      "ignition": {
        "default": "mdi:key-variant",
        "state": {
          "off": "mdi:key-outline"
        }
      },
      "moving": {
        "default": "mdi:truck-fast",
        "state": {
          "off": "mdi:truck"
        }
      },
      "channel_alarm": {
        "default": "mdi:alert-circle",
        "state": {
          "off": "mdi:check-circle-outline"
        }
      }
    }
  },
  "services": {
    "get_faults": {
      "service": "mdi:car-wrench"
    },
    "get_trips": {
      "service": "mdi:map-marker-path"
    },
    "get_history": {
      "service": "mdi:chart-line"
    }
  }
}
