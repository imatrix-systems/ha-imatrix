{
  "config": {
    "step": {
      "user": {
        "title": "Connect to iMatrix",
        "description": "Create an API key in the iMatrix web app under Account Settings, Security, API keys, using the Home Assistant (read-only) preset.",
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]"
        },
        "data_description": {
          "api_key": "The key starts with imx_ and is shown once when you create it."
        },
        "sections": {
          "advanced": {
            "name": "Advanced",
            "data": {
              "base_url": "API URL"
            },
            "data_description": {
              "base_url": "Leave as is unless iMatrix support gave you a different address."
            }
          }
        }
      },
      "reauth_confirm": {
        "title": "[%key:common::config_flow::title::reauth%]",
        "description": "iMatrix rejected the API key for {org}. Enter a new key for the same organization.",
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]"
        },
        "data_description": {
          "api_key": "The key starts with imx_ and is shown once when you create it."
        }
      },
      "reconfigure": {
        "title": "Reconfigure iMatrix",
        "description": "Change the API key or API URL. The key must belong to the same organization.",
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]"
        },
        "data_description": {
          "api_key": "The key starts with imx_ and is shown once when you create it."
        },
        "sections": {
          "advanced": {
            "name": "Advanced",
            "data": {
              "base_url": "API URL"
            },
            "data_description": {
              "base_url": "Leave as is unless iMatrix support gave you a different address."
            }
          }
        }
      }
    },
    "error": {
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "insufficient_permissions": "The API key cannot read devices or sensor data. Create a key with the Home Assistant (read-only) preset.",
      "unsupported_api": "The iMatrix server returned an API version this integration does not support. Update the integration.",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]",
      "wrong_account": "The API key belongs to a different iMatrix organization."
    }
  },
